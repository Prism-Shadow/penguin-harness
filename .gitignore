.DS_Store

# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo
# web assets copied into the server package at npm publish time
packages/server/web-dist/

# secrets / local config
.env
.env.*
!.env.example

# mmsp trace cache
cache/

# legacy .penguin workspace symlink (no longer created; ignored for old working copies)
.penguin

# logs
*.log

# Agent workspace. `.claude` is a committed symlink to `.agents`, so a
# Claude Code session and any other agent read the same `.agents/skills/`.
# The shared contents are tracked; only per-machine session state is not.
.agents/settings.local.json
.agents/**/*.local.*

# vitest --coverage reports
coverage/

# playwright e2e artifacts
packages/web/test-results/
# component gallery screenshots (scripts/shots.mjs); never committed
packages/ui-gallery/shots/
packages/web/playwright-report/

# blog images staged locally by the landing capture/render scripts, then uploaded to
# the community repo's assets/blog-assets/ — never committed here (see lib/community-assets.ts)
packages/landing/.blog-assets/

# local design-doc symlink and agent instructions
/design
/AGENTS.md
/CLAUDE.md

# generated by `pnpm gen:ifaces` (scripts/gen-ifaces.mjs, and scripts/gen-cli-modules.mjs for
# cli-modules.gen.ts); typecheck, build and test regenerate them
packages/cli/src/ifaces.json
packages/cli/src/cli-commands.gen.ts
packages/cli/src/cli-modules.gen.ts
packages/server/src/ifaces.json
packages/web/src/ifaces.json
plugins/*/ifaces.json
# rendered by scripts/iface-page.mjs (pnpm ifaces:page); CI publishes it
dist-ifaces/
plugins/sandbox-bwrap/vendor/
# Shared source copied into the standalone desk workbench packages by their builds
plugins/*/workbenches/*/desk-kit.ts
plugins/*/workbenches/*/ui/desk-kit.js
plugins/*/workbenches/*/ui/desk-kit.css

# plugin test instance data (penguin-testing-electron)
.data/
