.DS_Store

# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo
# web assets copied into the server package at npm publish time
packages/server/web-dist/

# secrets / local config
.env
.env.*
!.env.example

# agenthub trace cache
cache/

# legacy .penguin workspace symlink (no longer created; ignored for old working copies)
.penguin

# logs
*.log

# Agent workspace. `.claude` is a committed symlink to `.agents`, so a
# Claude Code session and any other agent read the same `.agents/skills/`.
# The shared contents are tracked; only per-machine session state is not.
.agents/settings.local.json
.agents/**/*.local.*

# playwright e2e artifacts
packages/web/test-results/
packages/web/playwright-report/

# blog images staged locally by the landing capture/render scripts, then uploaded to
# the community repo's blog-assets/ — never committed here (see lib/links.ts)
packages/landing/.blog-assets/

# local design-doc symlink and agent instructions
/design
/AGENTS.md
/CLAUDE.md

# generated by scripts/gen-ifaces.mjs (pnpm gen:ifaces); typecheck, build and test regenerate it
packages/server/src/ifaces.json
# rendered by scripts/iface-page.mjs (pnpm ifaces:page); CI publishes it
dist-ifaces/
