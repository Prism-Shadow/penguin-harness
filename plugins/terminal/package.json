{
  "name": "@penguinharness/plugin-terminal",
  "version": "0.2.18",
  "private": true,
  "type": "module",
  "description": "The terminal functional group: its server half and web pages in one package, temporarily parked under plugins/.",
  "exports": {
    "./server": "./src/server/index.ts",
    "./web": "./src/web/index.ts",
    "./server/*": "./src/server/*",
    "./web/*": "./src/web/*"
  },
  "dependencies": {
    "@prismshadow/penguin-core": "workspace:*",
    "@prismshadow/penguin-ui": "workspace:*",
    "@prismshadow/penguin-server": "workspace:*",
    "@prismshadow/penguin-web": "workspace:*",
    "@xterm/addon-clipboard": "^0.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "hono": "^4.12.34",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.5.0",
    "react-router": "^8.3.0",
    "typescript": "^5.8.0",
    "vite": "^7.3.6"
  },
  "penguin": {
    "parked": true
  },
  "scripts": {
    "build": "node ../../scripts/gen-ifaces.mjs --project tsconfig.json --out ifaces.json"
  },
  "files": [
    "ifaces.json"
  ]
}
