{
  "name": "@penguinharness/trace-lookup",
  "version": "0.2.18",
  "description": "Look up what happened earlier in a conversation from its Trace file, precisely — after a compaction or a model switch, when a detail is no longer in context.",
  "keywords": [
    "penguin-plugin",
    "penguinharness",
    "skills"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Prism-Shadow",
    "url": "https://github.com/Prism-Shadow"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "plugins/trace-lookup"
  },
  "files": [
    "icon.svg",
    "skills",
    "hooks",
    "ifaces.json",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "build": "node ../../scripts/gen-ifaces.mjs --project tsconfig.json --out ifaces.json"
  },
  "devDependencies": {
    "@prismshadow/penguin-core": "workspace:*",
    "@prismshadow/skills": "workspace:*",
    "vitest": "^4.1.12"
  }
