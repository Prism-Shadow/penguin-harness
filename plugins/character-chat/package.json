    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "plugins/character-chat"
  },
  "files": [
    "icon.svg",
    "skills",
    "workbenches",
    "ifaces.json",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
