{
  "name": "@penguinharness/continual-learning",
  "version": "0.2.18",
  "description": "Continual learning: a stop hook that, when the task that just ended ran more than 30 completed turns, hands a condensed excerpt of that task to a background subagent, which folds the durable findings into the agent's own skills.",
  "keywords": [
    "penguin-plugin",
    "penguinharness",
    "hooks"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Prism-Shadow",
    "url": "https://github.com/Prism-Shadow"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "plugins/continual-learning"
  },
  "files": [
    "icon.svg",
    "skills",
    "hooks",
    "ifaces.json",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/gen-ifaces.mjs --project tsconfig.json --out ifaces.json"
  },
  "devDependencies": {
    "@prismshadow/penguin-core": "workspace:*"
  }
}
