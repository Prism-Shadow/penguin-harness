{
  "name": "@penguinharness/agent-state-git",
  "version": "0.1.0",
  "type": "module",
  "description": "Native Git for PenguinHarness Agent State history: GitHub Desktop's dugite builds write workbench versions and read them back, faster than the built-in engine as workbenches grow.",
  "keywords": [
    "penguin-plugin",
    "penguinharness",
    "git",
    "dugite",
    "agent-state",
    "workbench-history"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Prism-Shadow",
    "url": "https://github.com/Prism-Shadow"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "plugins/agent-state-git"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "icon.svg",
    "ifaces.json",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "bench": "vitest run --config vitest.bench.config.ts",
    "build": "node ../../scripts/gen-ifaces.mjs --project tsconfig.json --out ifaces.json && tsup"
  },
  "devDependencies": {
    "@prismshadow/penguin-core": "workspace:*",
    "dugite": "3.3.3",
    "tar": "^7.5.21",
    "tsup": "^8.3.0",
    "vitest": "^4.1.12"
  }
}
