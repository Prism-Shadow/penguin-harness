{
  "name": "@penguinharness/plugin-workbenches",
  "version": "0.2.18",
  "private": true,
  "type": "module",
  "description": "The workbenches functional group: the workbench store, compiler and routes with the workbench pages, temporarily parked under plugins/.",
  "exports": {
    "./server": "./src/server/index.ts",
    "./web": "./src/web/index.ts",
    "./server/*": "./src/server/*",
    "./web/*": "./src/web/*"
  },
  "dependencies": {
    "@penguinharness/plugin-schedules": "workspace:*",
    "@prismshadow/penguin-core": "workspace:*",
    "@prismshadow/penguin-server": "workspace:*",
    "@prismshadow/penguin-ui": "workspace:*",
    "@prismshadow/penguin-web": "workspace:*",
    "hono": "^4.12.34",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^8.3.0",
    "typescript": "^5.8.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "vite": "^7.3.6"
  },
  "penguin": {
    "parked": true
  },
