{
  "name": "@penguinharness/pet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The pet plugin: a small companion the web app docks as a widget, with `penguin pet` commands and its state in the server's shared store.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "ui",
    "README.md",
    "ifaces.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "node ../../scripts/gen-ifaces.mjs --project tsconfig.json --out ifaces.json && tsup && pnpm run build:ui",
    "build:ui": "vite build --config ui/vite.config.ts"
  },
  "devDependencies": {
    "@prismshadow/penguin-core": "workspace:*",
    "@prismshadow/penguin-server": "workspace:*",
    "@prismshadow/penguin-ui": "workspace:*",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "commander": "^14.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.3.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.6"
  }
}
