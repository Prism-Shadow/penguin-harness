{
  // The server half and its tests, in the server's program (its paths reach the host's
  // face from source, the way gen-ifaces projects the host's interfaces into the table).
  // The web half has its own, tsconfig.web.json; `jsx` is here too because a bundler
  // compiling a src/web file reads the nearest tsconfig.json, whatever it includes.
  "extends": "../../packages/server/tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "jsx": "react-jsx"
  },
  "include": ["src", "test"],
  "exclude": ["src/web"]
}
