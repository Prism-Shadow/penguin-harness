{
  "name": "@penguinharness/sandbox-wsl",
  "version": "0.2.3",
  "type": "module",
  "description": "WSL sandbox backend for PenguinHarness on Windows: commands run in a dedicated WSL2 distro under bubblewrap, with Windows interop switched off.",
  "keywords": [
    "penguin-plugin",
    "penguinharness",
    "sandbox",
    "windows",
    "wsl",
    "bubblewrap",
    "network-isolation",
    "path-masking"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "plugins/sandbox-wsl"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "setup",
    "README.md",
    "icon.svg",
    "ifaces.json",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "node ../../scripts/gen-ifaces.mjs --project tsconfig.json --out ifaces.json && tsup"
  },
  "devDependencies": {
    "@prismshadow/penguin-core": "workspace:*",
    "tsup": "^8.3.0",
    "vitest": "^3.2.6"
  },
  "penguin": {
    "description_zh": "PenguinHarness 在 Windows 上的 WSL 沙箱后端：命令在专用的 WSL2 发行版中经 bubblewrap 运行，并关闭 Windows 互操作。",
    "short_description": "Windows: run commands in a confined WSL2 distro.",
    "short_description_zh": "Windows：在受限的 WSL2 发行版中运行命令。",
    "category": "sandbox",
    "icon": "icon.svg",
    "preinstall": false
  }
}
