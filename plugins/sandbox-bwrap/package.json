{
  "name": "@prismshadow/penguin-plugin-sandbox-bwrap",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Bubblewrap sandbox backend for PenguinHarness: filesystem confinement plus network isolation and path masking.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsup"
  },
  "devDependencies": {
    "@prismshadow/penguin-core": "workspace:*",
    "tsup": "^8.3.0",
    "vitest": "^3.2.6"
  },
  "penguin": {
    "modules": [
      {
        "name": "SandboxBwrap",
        "requires": {},
        "provides": {},
        "contributes": {
          "SandboxModule.providers": [
            {
              "id": "sandbox-bwrap.provider",
              "name": "penguin-bwrap",
              "dimensions": [
                "fs-write",
                "network",
                "mask-paths"
              ]
            }
          ]
        },
        "children": []
      }
    ]
  }
}
