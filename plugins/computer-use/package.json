{
  "name": "@penguinharness/computer-use",
  "version": "0.1.3",
  "type": "module",
  "description": "Computer use for PenguinHarness: Agents see and operate desktop apps on macOS, Windows and Linux through their accessibility trees, with agent-desktop.",
  "keywords": [
    "penguin-plugin",
    "penguinharness",
    "computer-use",
    "desktop-automation",
    "accessibility",
    "agent-desktop"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Prism-Shadow",
    "url": "https://github.com/Prism-Shadow"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "plugins/computer-use"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "icon.svg",
    "ifaces.json",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "node ../../scripts/gen-ifaces.mjs --project tsconfig.json --out ifaces.json && tsup",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@prismshadow/penguin-core": "workspace:>=0.2.0",
    "@prismshadow/skills": "workspace:>=0.2.0",
    "commander": "^13.0.0",
    "tsup": "^8.3.0",
    "vitest": "^4.1.12"
  }
}
