{
  "steps": [
    {
      "records": [
        {
          "type": "session_meta",
          "payload": { "session_id": "$SESSION", "agent_state": "$AGENT_STATE" }
        },
        {
          "type": "model_msg",
          "payload": { "type": "text", "role": "user", "text": "what is in this repo?" }
        },
        {
          "type": "model_msg",
          "payload": {
            "type": "text",
            "role": "assistant",
            "text": "A TypeScript SDK and CLI.",
            "stop_reason": "completed"
          }
        },
        {
          "type": "event_msg",
          "payload": { "type": "token_usage", "request": { "total": 80, "cache_read": 0 } }
        },
        { "type": "event_msg", "payload": { "type": "request_end", "status": "completed" } }
      ]
    }
  ]
}
