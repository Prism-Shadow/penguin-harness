{
  "start": { "objective": "make all tests pass", "budget": 100 },
  "steps": [
    {
      "records": [
        {
          "type": "session_meta",
          "payload": { "session_id": "$SESSION", "agent_state": "$AGENT_STATE" }
        },
        {
          "type": "model_msg",
          "payload": { "type": "text", "role": "user", "text": "make all tests pass" }
        },
        {
          "type": "model_msg",
          "payload": {
            "type": "text",
            "role": "user",
            "text": "$ROUND_INPUT",
            "sender": "harness"
          }
        },
        {
          "type": "model_msg",
          "payload": {
            "type": "text",
            "role": "assistant",
            "text": "Read the failing suites; still three red.",
