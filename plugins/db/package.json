{
  "name": "@penguinharness/plugin-db",
  "version": "0.2.16",
  "private": true,
  "type": "module",
  "description": "The database core as one parked platform group: the connection, the frozen schema and the migrations. Server-only (node:sqlite); the repos that give the tables their shapes stay with the server.",
  "exports": {
    "./server": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "node ../../scripts/gen-ifaces.mjs --project tsconfig.json --project ../../plugins/company/tsconfig.json --project ../../plugins/terminal/tsconfig.json --project ../../plugins/machines/tsconfig.json --project ../../plugins/plugins/tsconfig.json --project ../../plugins/workbenches/tsconfig.json --project ../../plugins/models/tsconfig.json --project ../../plugins/browser/tsconfig.json --project ../../plugins/messaging/tsconfig.json --project ../../plugins/agents/tsconfig.json --project ../../plugins/projects/tsconfig.json --project ../../plugins/sessions/tsconfig.json --project ../../plugins/settings/tsconfig.json --project ../../plugins/usage/tsconfig.json --project ../../plugins/schedules/tsconfig.json --project ../../plugins/sandbox/tsconfig.json --out ifaces.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "penguin": {
    "parked": true
  },
  "files": [
    "ifaces.json"
  ]
}
