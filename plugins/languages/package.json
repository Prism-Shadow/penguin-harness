{
  "name": "@prismshadow/penguin-plugin-languages",
  "version": "0.1.0",
  "type": "module",
  "description": "Syntax highlighting for Typst, Swift, Kotlin, C# and Dart in PenguinHarness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "plugins/languages"
  },
  "homepage": "https://github.com/Prism-Shadow/penguin-harness/tree/main/plugins/languages",
  "keywords": [
    "penguin-harness-plugin",
    "syntax-highlighting",
    "typst",
    "swift",
    "kotlin",
    "csharp",
    "dart"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "ifaces.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/gen-ifaces.mjs --project tsconfig.json --out ifaces.json && vitest run --passWithNoTests",
    "build": "node ../../scripts/gen-ifaces.mjs --project tsconfig.json --out ifaces.json && tsup"
  },
  "dependencies": {
    "@shikijs/langs": "^4.3.1"
  },
  "devDependencies": {
    "@prismshadow/penguin-core": "workspace:*",
    "tsup": "^8.3.0",
    "vitest": "^3.2.6"
  }
}
