        "../models/src/web/index.ts"
      ],
      "@penguinharness/plugin-plugins/server": [
        "../plugins/src/server/index.ts"
      ],
      "@penguinharness/plugin-projects/server": [
        "../projects/src/server/index.ts"
      ],
      "@penguinharness/plugin-sandbox/server": [
        "../../plugins/sandbox/src/server/index.ts"
