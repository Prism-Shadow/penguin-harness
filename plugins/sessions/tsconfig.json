        "../../plugins/terminal/src/server/index.ts"
      ],
      "@penguinharness/plugin-terminal/server/*": [
        "../../plugins/terminal/src/server/*"
      ],
      "@penguinharness/plugin-terminal/web": [
        "../terminal/src/web/index.ts"
      ],
      "@penguinharness/plugin-usage/server": [
        "../usage/src/server/index.ts"
      ],
      "@penguinharness/plugin-workbenches/server": [
        "../../plugins/workbenches/src/server/index.ts"
