      "@penguinharness/plugin-schedules/web": [
        "../schedules/src/web/index.ts"
      ],
      "@penguinharness/plugin-sessions/server": [
        "./src/server/index.ts"
      ],
      "@penguinharness/plugin-sessions/web": [
        "./src/web/index.ts"
      ],
      "@penguinharness/plugin-settings/server": [
        "../../plugins/settings/src/server/index.ts"
