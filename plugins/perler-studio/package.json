    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "plugins/perler-studio"
  },
  "files": [
    "icon.svg",
    "workbenches",
    "ifaces.json",
    "LICENSE",
    "README.md",
    "README.zh.md"
