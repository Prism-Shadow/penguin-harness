{
  "name": "@penguinharness/multimodal-tools",
  "version": "0.2.18",
  "description": "Use project models for web search, page retrieval, image and video generation, speech recognition and speech synthesis.",
  "license": "Apache-2.0",
  "author": {
    "name": "Prism-Shadow",
    "url": "https://github.com/Prism-Shadow"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "plugins/multimodal-tools"
  },
  "files": [
    "dist",
    "skills",
    "icon.svg",
    "ifaces.json",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/gen-ifaces.mjs --project tsconfig.json --out ifaces.json && tsup src/index.ts --format esm --target node24 --out-dir dist --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@prismshadow/penguin-core": "workspace:*",
    "vitest": "^4.1.12",
    "tsup": "^8.3.0"
  },
  "keywords": [
    "penguin-plugin",
    "skills",
    "multimodal",
    "web-search",
    "image",
    "video",
    "speech"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
