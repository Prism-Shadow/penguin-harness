{
  "name": "@penguinharness/multimodal-tools",
  "version": "0.2.18",
  "type": "module",
  "description": "Generate text, read images, search and fetch the web, generate images, video and speech, and transcribe recordings with the Project's models, through penguin tools.",
  "keywords": [
    "penguin-plugin",
    "skills",
    "multimodal",
    "web-search",
    "image",
    "video",
    "speech"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Prism-Shadow",
    "url": "https://github.com/Prism-Shadow"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "plugins/multimodal-tools"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "workbenches",
    "icon.svg",
    "ifaces.json",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/gen-ifaces.mjs --project tsconfig.json --out ifaces.json && tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@prismshadow/mmsp": "^0.5.10",
    "@prismshadow/penguin-core": "workspace:*",
    "@prismshadow/skills": "workspace:*",
    "commander": "^13.0.0",
    "hono": "^4.13.11",
    "tsup": "^8.3.0",
    "vitest": "^4.1.12"
  }
}
