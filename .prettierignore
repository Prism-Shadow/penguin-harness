# plugin library was staged under (packages/desktop/.gitignore lists the same)
packages/desktop/out/
packages/desktop/skills/
packages/desktop/plugins/
packages/desktop/official/

# Frost's MiSans slices and their @font-face sheet, written by scripts/build-misans.py (a
