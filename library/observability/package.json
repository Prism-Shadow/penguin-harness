{
  "name": "@prismshadow/penguin-library-observability",
  "version": "0.2.20",
  "description": "The observability domain: the ErrorLog/Errors, UsageStore/UsageRecording mechanisms, the usage grouping, and the errors/usage repos. A library package - the server imports it; nothing here imports the server.",
  "license": "Apache-2.0",
  "author": {
    "name": "Prism-Shadow",
    "url": "https://github.com/Prism-Shadow"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "library/observability"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./observability": {
      "types": "./dist/observability.d.ts",
      "import": "./dist/observability.js"
    },
    "./usage-service": {
      "types": "./dist/usage-service.d.ts",
      "import": "./dist/usage-service.js"
    },
    "./dates": {
      "types": "./dist/dates.d.ts",
      "import": "./dist/dates.js"
    },
    "./repos/errors": {
      "types": "./dist/repos/errors.d.ts",
      "import": "./dist/repos/errors.js"
    },
    "./repos/usage": {
      "types": "./dist/repos/usage.d.ts",
      "import": "./dist/repos/usage.js"
    },
    "./repos": {
      "types": "./dist/repos/index.d.ts",
      "import": "./dist/repos/index.js"
    },
    "./web": "./src/web/index.ts",
    "./web/*": "./src/web/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsup"
  },
  "dependencies": {
    "@prismshadow/penguin-core": "workspace:*",
    "@prismshadow/penguin-library-agent-api": "workspace:*",
    "@prismshadow/penguin-library-db": "workspace:*",
    "@prismshadow/penguin-library-http": "workspace:*",
    "@prismshadow/penguin-library-model": "workspace:*",
    "@prismshadow/penguin-library-project": "workspace:*",
    "@prismshadow/penguin-library-trace": "workspace:*"
  },
  "devDependencies": {
    "@prismshadow/penguin-library-setting": "workspace:*",
    "@prismshadow/penguin-server": "workspace:*",
    "@prismshadow/penguin-ui": "workspace:*",
    "@prismshadow/penguin-web": "workspace:*",
    "@types/react": "^19.1.0",
    "react": "^19.1.0",
    "react-router": "^8.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true
}
