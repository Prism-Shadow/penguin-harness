{
  "name": "@prismshadow/penguin-library-db",
  "version": "0.2.20",
  "description": "The server's SQLite database: the connection (open/readonly/narrow-write), the table-creation SQL, the named migrations, and the Db capability the runtime publishes. A library package \u2014 the server imports it; nothing here imports the server.",
  "license": "Apache-2.0",
  "author": {
    "name": "Prism-Shadow",
    "url": "https://github.com/Prism-Shadow"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "library/db"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "import": "./dist/database.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "import": "./dist/migrations/index.js"
    },
    "./migrations/runner": {
      "types": "./dist/migrations/runner.d.ts",
      "import": "./dist/migrations/runner.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsup"
  },
  "dependencies": {
    "@prismshadow/penguin-core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true
}
