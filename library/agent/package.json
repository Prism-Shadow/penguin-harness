    "directory": "library/agent"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    "./web": "./src/web/index.ts",
    "./web/agents/agent-groups": "./src/web/agents/agent-groups.ts",
