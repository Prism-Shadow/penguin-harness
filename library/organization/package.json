{
  "name": "@prismshadow/penguin-library-organization",
  "version": "0.2.20",
  "description": "The organization domain: the OrgCache mechanism and the org cache repo it reads through. A library package - the server imports it; nothing here imports the server. Its web half (./web, company mode) is TypeScript source the Web App compiles with itself.",
  "license": "Apache-2.0",
  "author": {
    "name": "Prism-Shadow",
    "url": "https://github.com/Prism-Shadow"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "library/organization"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./organization": {
      "types": "./dist/organization.d.ts",
      "import": "./dist/organization.js"
    },
    "./organizations": {
      "types": "./dist/organizations.d.ts",
      "import": "./dist/organizations.js"
    },
    "./web": "./src/web/index.ts",
