    "./web/company/org-sessions": "./src/web/company/org-sessions.ts",
    "./web/company/overview-summary": "./src/web/company/overview-summary.ts",
    "./web/company/page-hints": "./src/web/company/page-hints.ts",
    "./web/company/path-capsule": "./src/web/company/path-capsule.tsx",
