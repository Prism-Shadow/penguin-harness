    "./web/company/finance-tree": "./src/web/company/finance-tree.ts",
    "./web/company/handbook-page": "./src/web/company/handbook-page.tsx",
    "./web/company/home-redirect": "./src/web/company/home-redirect.tsx",
    "./web/company/mention-draft": "./src/web/company/mention-draft.ts",
