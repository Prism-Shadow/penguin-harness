{
  "name": "@prismshadow/penguin-library-project",
  "version": "0.2.18",
  "description": "The projects domain: the Projects, Members, AgentIndex, ModelPromotions and ModelProviderAuthTokens mechanisms with their DTOs, and the five repos that store them. A library package - the server imports it; nothing here imports the server.",
  "license": "Apache-2.0",
  "author": {
    "name": "Prism-Shadow",
    "url": "https://github.com/Prism-Shadow"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "library/project"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "import": "./dist/project.js"
    },
    "./repos/agents": {
      "types": "./dist/repos/agents.d.ts",
      "import": "./dist/repos/agents.js"
    },
    "./repos/members": {
      "types": "./dist/repos/members.d.ts",
      "import": "./dist/repos/members.js"
    },
    "./repos/projects": {
      "types": "./dist/repos/projects.d.ts",
      "import": "./dist/repos/projects.js"
    },
    "./repos": {
      "types": "./dist/repos/index.d.ts",
      "import": "./dist/repos/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsup"
  },
  "dependencies": {
    "@prismshadow/amsp": "workspace:*",
    "@prismshadow/penguin-core": "workspace:*",
    "@prismshadow/penguin-library-agent-api": "workspace:*",
    "@prismshadow/penguin-library-db": "workspace:*",
    "@prismshadow/penguin-library-auth": "workspace:*",
    "@prismshadow/penguin-library-machine": "workspace:*",
    "@prismshadow/penguin-library-model": "workspace:*",
    "@prismshadow/penguin-library-organization": "workspace:*",
    "@prismshadow/penguin-library-session": "workspace:*",
    "@prismshadow/penguin-library-trace": "workspace:*",
    "@prismshadow/penguin-library-workbench": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
