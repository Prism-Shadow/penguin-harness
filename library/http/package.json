{
  "name": "@prismshadow/penguin-library-http",
  "version": "0.2.19",
  "description": "The server's HTTP vocabulary: the unified error shape, the request-validation helpers, the JSON answer rules (validators, compression), the public origin and page CSP, and the Hono env the auth middleware fills. A library package - the server imports it; nothing here imports the server.",
  "license": "Apache-2.0",
  "author": {
    "name": "Prism-Shadow",
    "url": "https://github.com/Prism-Shadow"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "library/http"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./app-env": {
      "types": "./dist/app-env.d.ts",
      "import": "./dist/app-env.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "import": "./dist/validate.js"
    },
    "./media-type": {
      "types": "./dist/media-type.d.ts",
      "import": "./dist/media-type.js"
    },
    "./json-answer": {
      "types": "./dist/json-answer.d.ts",
      "import": "./dist/json-answer.js"
    },
    "./json-compression": {
      "types": "./dist/json-compression.d.ts",
      "import": "./dist/json-compression.js"
    },
    "./json-validators": {
      "types": "./dist/json-validators.d.ts",
      "import": "./dist/json-validators.js"
    },
    "./public-origin": {
      "types": "./dist/public-origin.d.ts",
      "import": "./dist/public-origin.js"
    },
    "./page-csp": {
      "types": "./dist/page-csp.d.ts",
      "import": "./dist/page-csp.js"
    },
    "./settle": {
      "types": "./dist/settle.d.ts",
      "import": "./dist/settle.js"
    },
    "./socket-frames": {
      "types": "./dist/socket-frames.d.ts",
      "import": "./dist/socket-frames.js"
    },
    "./socket-credit-window": {
      "types": "./dist/socket-credit-window.d.ts",
      "import": "./dist/socket-credit-window.js"
    },
    "./socket-stream-answer": {
      "types": "./dist/socket-stream-answer.d.ts",
      "import": "./dist/socket-stream-answer.js"
    },
    "./socket-line-frames": {
      "types": "./dist/socket-line-frames.d.ts",
      "import": "./dist/socket-line-frames.js"
    },
    "./socket-sse-text": {
      "types": "./dist/socket-sse-text.d.ts",
      "import": "./dist/socket-sse-text.js"
    },
    "./event-stream": {
      "types": "./dist/event-stream.d.ts",
      "import": "./dist/event-stream.js"
    },
    "./attribution": {
      "types": "./dist/attribution.d.ts",
      "import": "./dist/attribution.js"
    },
    "./skill-import-limits": {
      "types": "./dist/skill-import-limits.d.ts",
      "import": "./dist/skill-import-limits.js"
    },
    "./zip-entries": {
      "types": "./dist/zip-entries.d.ts",
      "import": "./dist/zip-entries.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsup"
  },
  "dependencies": {
    "@prismshadow/penguin-core": "workspace:*",
    "@prismshadow/penguin-library-auth": "workspace:*",
    "hono": "^4.13.11",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true
}
