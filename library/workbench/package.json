{
  "name": "@prismshadow/penguin-library-workbench",
  "version": "0.2.20",
  "description": "The workbenches domain: what a workbench is as the server holds it and shows it, the request/response pair its main handler speaks, and the host surface a workbench's SDK calls. A library package - the server imports it; nothing here imports the server. Its web half (./web, the workbench pages and the App Center) is TypeScript source the Web App compiles with itself.",
  "license": "Apache-2.0",
  "author": {
    "name": "Prism-Shadow",
    "url": "https://github.com/Prism-Shadow"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "library/workbench"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workbench": {
      "types": "./dist/workbench.d.ts",
      "import": "./dist/workbench.js"
    },
    "./web": "./src/web/index.ts",
    "./web/app-center/app-center-page": "./src/web/app-center/app-center-page.tsx",
    "./web/app-center/app-center-windows": "./src/web/app-center/app-center-windows.tsx",
    "./web/app-center/arrangement": "./src/web/app-center/arrangement.ts",
    "./web/app-center/system-app-page": "./src/web/app-center/system-app-page.tsx",
    "./web/app-center/tile-drag": "./src/web/app-center/tile-drag.ts",
    "./web/workbenches/exit-ball-state": "./src/web/workbenches/exit-ball-state.ts",
    "./web/workbenches/workbench-app-page": "./src/web/workbenches/workbench-app-page.tsx",
    "./web/workbenches/workbench-frame": "./src/web/workbenches/workbench-frame.tsx",
    "./web/workbenches/workbench-load-failure": "./src/web/workbenches/workbench-load-failure.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsup"
  },
  "dependencies": {
    "@prismshadow/penguin-core": "workspace:*",
    "@prismshadow/penguin-ui": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true
}
