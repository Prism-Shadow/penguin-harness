{
  "name": "@prismshadow/penguin-library-session",
  "version": "0.2.20",
  "description": "The sessions domain: the SessionIndex, SessionDrivers, SessionOrigins and Schedules mechanisms, the ApprovalMode vocabulary, the SessionInfo view, the session index/deletion/archive-page services and the listing rule. A library package - the server imports it; nothing here imports the server.",
  "license": "Apache-2.0",
  "author": {
    "name": "Prism-Shadow",
    "url": "https://github.com/Prism-Shadow"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "library/session"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./session-title": {
      "types": "./dist/session-title.d.ts",
      "import": "./dist/session-title.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./session-service": {
      "types": "./dist/session-service.d.ts",
      "import": "./dist/session-service.js"
    },
    "./session-deletion": {
      "types": "./dist/session-deletion.d.ts",
      "import": "./dist/session-deletion.js"
    },
    "./archived-sessions-service": {
      "types": "./dist/archived-sessions-service.d.ts",
      "import": "./dist/archived-sessions-service.js"
    },
    "./ports": {
      "types": "./dist/ports.d.ts",
      "import": "./dist/ports.js"
    },
    "./access": {
      "types": "./dist/access.d.ts",
      "import": "./dist/access.js"
    },
    "./repos/schedules": {
      "types": "./dist/repos/schedules.d.ts",
      "import": "./dist/repos/schedules.js"
    },
    "./repos/sessions": {
      "types": "./dist/repos/sessions.d.ts",
      "import": "./dist/repos/sessions.js"
    },
    "./repos": {
      "types": "./dist/repos/index.d.ts",
      "import": "./dist/repos/index.js"
    },
    "./schedule-file": {
      "types": "./dist/schedule-file.d.ts",
      "import": "./dist/schedule-file.js"
    },
    "./schedule-store": {
      "types": "./dist/schedule-store.d.ts",
      "import": "./dist/schedule-store.js"
    },
    "./schedules": {
      "types": "./dist/schedules.d.ts",
      "import": "./dist/schedules.js"
    },
    "./schedules-status": {
      "types": "./dist/schedules-status.d.ts",
      "import": "./dist/schedules-status.js"
    },
    "./mtime-gate": {
      "types": "./dist/mtime-gate.d.ts",
      "import": "./dist/mtime-gate.js"
    },
    "./listing": {
      "types": "./dist/listing.d.ts",
      "import": "./dist/listing.js"
    },
    "./session-id": {
      "types": "./dist/session-id.d.ts",
      "import": "./dist/session-id.js"
    },
    "./trace-file-path": {
      "types": "./dist/trace-file-path.d.ts",
      "import": "./dist/trace-file-path.js"
    },
    "./system-agent": {
      "types": "./dist/system-agent.d.ts",
      "import": "./dist/system-agent.js"
    },
    "./sandbox-ceiling": {
      "types": "./dist/sandbox-ceiling.d.ts",
      "import": "./dist/sandbox-ceiling.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsup"
  },
  "dependencies": {
    "@prismshadow/penguin-core": "workspace:*",
    "@prismshadow/penguin-library-db": "workspace:*",
    "@prismshadow/penguin-library-http": "workspace:*",
    "@prismshadow/amsp": "workspace:*",
    "hono": "^4.13.11",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true
}
