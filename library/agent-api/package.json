{
  "name": "@prismshadow/penguin-library-agent-api",
  "version": "0.2.18",
  "description": "The agent-api domain: the AgentApi mechanism, its settings/update DTOs, the ModelRefDto pair, and the agent_api repos. A library package - the server imports it; nothing here imports the server.",
  "license": "Apache-2.0",
  "author": {
    "name": "Prism-Shadow",
    "url": "https://github.com/Prism-Shadow"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "library/agent-api"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent-api-repo": {
      "types": "./dist/agent-api-repo.d.ts",
      "import": "./dist/agent-api-repo.js"
    },
    "./agent-api": {
      "types": "./dist/agent-api.d.ts",
      "import": "./dist/agent-api.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsup"
  },
  "dependencies": {
    "@prismshadow/penguin-core": "workspace:*",
    "@prismshadow/penguin-library-db": "workspace:*",
    "@prismshadow/penguin-library-session": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  }
}
