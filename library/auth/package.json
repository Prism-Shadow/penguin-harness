{
  "name": "@prismshadow/penguin-library-auth",
  "version": "0.2.20",
  "description": "The auth domain: the Users, AuthSessions, Auth and Admin mechanisms, the SessionVia vocabulary, the UserInfo view, the users/auth_sessions repos, and what an account keeps beside its preferences (the UserDraftsStore and BackgroundImageStore mechanisms and their repos). A library package - the server imports it; nothing here imports the server.",
  "license": "Apache-2.0",
  "author": {
    "name": "Prism-Shadow",
    "url": "https://github.com/Prism-Shadow"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "library/auth"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./account-data": {
      "types": "./dist/account-data.d.ts",
      "import": "./dist/account-data.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./repos/auth-sessions": {
      "types": "./dist/repos/auth-sessions.d.ts",
      "import": "./dist/repos/auth-sessions.js"
    },
    "./repos/background-images": {
      "types": "./dist/repos/background-images.d.ts",
      "import": "./dist/repos/background-images.js"
    },
    "./repos/user-drafts": {
      "types": "./dist/repos/user-drafts.d.ts",
      "import": "./dist/repos/user-drafts.js"
    },
    "./repos/users": {
      "types": "./dist/repos/users.d.ts",
      "import": "./dist/repos/users.js"
    },
    "./repos": {
      "types": "./dist/repos/index.d.ts",
      "import": "./dist/repos/index.js"
    },
    "./api-token": {
      "types": "./dist/api-token.d.ts",
      "import": "./dist/api-token.js"
    },
    "./live-streams": {
      "types": "./dist/live-streams.d.ts",
      "import": "./dist/live-streams.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    },
    "./password": {
      "types": "./dist/password.d.ts",
      "import": "./dist/password.js"
    },
    "./require-human": {
      "types": "./dist/require-human.d.ts",
      "import": "./dist/require-human.js"
    },
    "./runtime-state": {
      "types": "./dist/runtime-state.d.ts",
      "import": "./dist/runtime-state.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    },
    "./auth-token": {
      "types": "./dist/auth-token.d.ts",
      "import": "./dist/auth-token.js"
    },
    "./initial-password": {
      "types": "./dist/initial-password.d.ts",
      "import": "./dist/initial-password.js"
    },
    "./reset-admin-password": {
      "types": "./dist/reset-admin-password.d.ts",
      "import": "./dist/reset-admin-password.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsup"
  },
  "dependencies": {
    "@prismshadow/penguin-core": "workspace:*",
    "@prismshadow/penguin-library-db": "workspace:*",
    "hono": "^4.13.11",
    "@prismshadow/penguin-library-http": "workspace:*",
    "@prismshadow/penguin-library-cli": "workspace:*",
    "@prismshadow/penguin-library-agent-api": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true
}
