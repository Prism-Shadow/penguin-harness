{
  "name": "@prismshadow/penguin-library-model",
  "version": "0.2.20",
  "description": "The models domain: the model/credential plumbing vocabulary (the DTOs the models routes return and take), the ModelOAuth mechanism and its flow vocabulary, and the model promotions / provider auth token repos. A library package - the server imports it; nothing here imports the server. Its web half (./web, the model pages and the model picker) is TypeScript source the Web App compiles with itself.",
  "license": "Apache-2.0",
  "author": {
    "name": "Prism-Shadow",
    "url": "https://github.com/Prism-Shadow"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "library/model"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    "./web": "./src/web/index.ts",
    "./web/model-picker/model-picker-logic": "./src/web/model-picker/model-picker-logic.ts",
    "./web/model-picker/model-picker-modal": "./src/web/model-picker/model-picker-modal.tsx",
    "./web/model-picker/thinking-level": "./src/web/model-picker/thinking-level.ts",
    "./web/models/balance": "./src/web/models/balance.ts",
    "./web/models/connection": "./src/web/models/connection.ts",
    "./web/models/default-models": "./src/web/models/default-models.tsx",
    "./web/models/default-models-layer": "./src/web/models/default-models-layer.tsx",
    "./web/models/group-balance": "./src/web/models/group-balance.tsx",
    "./web/models/group-connection": "./src/web/models/group-connection.tsx",
    "./web/models/group-header": "./src/web/models/group-header.ts",
    "./web/models/group-import": "./src/web/models/group-import.ts",
    "./web/models/group-settings-menu": "./src/web/models/group-settings-menu.tsx",
    "./web/models/main-sidebar-badges.module": "./src/web/models/main-sidebar-badges.module.ts",
    "./web/models/model-dialog-details": "./src/web/models/model-dialog-details.tsx",
    "./web/models/model-group-expansion": "./src/web/models/model-group-expansion.ts",
    "./web/models/model-group-pins": "./src/web/models/model-group-pins.ts",
    "./web/models/model-sort": "./src/web/models/model-sort.ts",
    "./web/models/models-page": "./src/web/models/models-page.tsx",
    "./web/models/module": "./src/web/models/module.ts",
    "./web/models/preset-sync": "./src/web/models/preset-sync.tsx",
    "./web/models/protocol-path": "./src/web/models/protocol-path.ts",
    "./web/models/protocol-suffix": "./src/web/models/protocol-suffix.tsx",
    "./web/models/protocol-types": "./src/web/models/protocol-types.ts",
    "./web/models/provider-settings-dialog": "./src/web/models/provider-settings-dialog.tsx",
    "./web/models/speed-test": "./src/web/models/speed-test.ts",
    "./web/models/tokendance-banner": "./src/web/models/tokendance-banner.tsx",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./origins": {
      "types": "./dist/origins.d.ts",
      "import": "./dist/origins.js"
    },
    "./platform-auth-flow": {
      "types": "./dist/platform-auth-flow.d.ts",
      "import": "./dist/platform-auth-flow.js"
    },
    "./model-oauth-service": {
      "types": "./dist/model-oauth-service.d.ts",
      "import": "./dist/model-oauth-service.js"
    },
    "./modelscope-auth-service": {
      "types": "./dist/modelscope-auth-service.d.ts",
      "import": "./dist/modelscope-auth-service.js"
    },
    "./platform-auth-service": {
      "types": "./dist/platform-auth-service.d.ts",
      "import": "./dist/platform-auth-service.js"
    },
    "./model-catalog": {
      "types": "./dist/model-catalog/index.d.ts",
      "import": "./dist/model-catalog/index.js"
    },
    "./model-catalog/catalog": {
      "types": "./dist/model-catalog/catalog.d.ts",
      "import": "./dist/model-catalog/catalog.js"
    },
    "./model-catalog/client-protocols": {
      "types": "./dist/model-catalog/client-protocols.d.ts",
      "import": "./dist/model-catalog/client-protocols.js"
    },
    "./model-catalog/env-keys": {
      "types": "./dist/model-catalog/env-keys.d.ts",
      "import": "./dist/model-catalog/env-keys.js"
    },
    "./model-catalog/seed": {
      "types": "./dist/model-catalog/seed.d.ts",
      "import": "./dist/model-catalog/seed.js"
    },
    "./repos/model-promotions": {
      "types": "./dist/repos/model-promotions.d.ts",
      "import": "./dist/repos/model-promotions.js"
    },
    "./repos/model-provider-auth-tokens": {
      "types": "./dist/repos/model-provider-auth-tokens.d.ts",
      "import": "./dist/repos/model-provider-auth-tokens.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsup"
  },
  "dependencies": {
    "@prismshadow/penguin-core": "workspace:*",
    "@prismshadow/penguin-library-agent-api": "workspace:*",
    "@prismshadow/penguin-library-db": "workspace:*",
    "@prismshadow/penguin-library-http": "workspace:*",
    "@prismshadow/mmsp": "^0.5.12",
    "@prismshadow/penguin-ui": "workspace:*",
    "react": "^19.1.0",
    "react-router": "^8.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "@types/react": "^19.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true
}
