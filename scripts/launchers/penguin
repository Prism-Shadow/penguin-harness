#!/bin/sh
# penguin CLI launcher, installed as bin/penguin inside the program directory.
#
# Runs the CLI on the Node runtime bundled at node/ when this package carries one,
# otherwise on system Node (>= 24). The web assets sit beside it at web/.

# This script's real location; readlink -f is not portable to macOS, hence the loop.
SOURCE=$0
while [ -h "$SOURCE" ]; do
  DIR=$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)
  SOURCE=$(readlink "$SOURCE")
  case $SOURCE in
    /*) ;;
    *) SOURCE="$DIR/$SOURCE" ;;
  esac
done
DIR=$(dirname "$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)")

export PENGUIN_WEB_DIST="${PENGUIN_WEB_DIST:-$DIR/web}"
# The test browser a platform package ships (see scripts/package-release-bundles.sh).
if [ -d "$DIR/browsers" ]; then
  export PENGUIN_BUNDLED_BROWSERS="${PENGUIN_BUNDLED_BROWSERS:-$DIR/browsers}"
fi
if [ -x "$DIR/node/bin/node" ]; then
  exec "$DIR/node/bin/node" "$DIR/lib/dist/penguin.js" "$@"
fi
exec node "$DIR/lib/dist/penguin.js" "$@"
