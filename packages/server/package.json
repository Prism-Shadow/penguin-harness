{
  "name": "@prismshadow/penguin-server",
  "version": "0.2.16",
  "type": "module",
  "description": "PenguinHarness web server: multi-user authentication and authorization, Session execution with SSE streaming, and usage accounting, built on @prismshadow/penguin-core.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "packages/server"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api/types.d.ts",
      "import": "./dist/api/types.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./ifaces.json": "./src/ifaces.json",
    "./machine-status": {
      "types": "./dist/machine-status.d.ts",
      "import": "./dist/machine-status.js"
    },
    "./lock": {
      "types": "./dist/lock.d.ts",
      "import": "./dist/lock.js"
    },
    "./initial-password": {
      "types": "./dist/initial-password.d.ts",
      "import": "./dist/initial-password.js"
    },
    "./reset-admin-password": {
      "types": "./dist/reset-admin-password.d.ts",
      "import": "./dist/reset-admin-password.js"
    },
    "./hmr/manifest": {
      "types": "./dist/hmr/manifest.d.ts",
      "import": "./dist/hmr/manifest.js"
    },
    "./harness-meta": {
      "types": "./dist/harness-meta.d.ts",
      "import": "./dist/harness-meta.js"
    },
    "./cli-shim": {
      "types": "./dist/cli-shim.d.ts",
      "import": "./dist/cli-shim.js"
    },
    "./version-report": {
      "types": "./dist/version-report.d.ts",
      "import": "./dist/version-report.js"
    },
    "./auth-token": {
      "types": "./dist/auth-token.d.ts",
      "import": "./dist/auth-token.js"
    },
    "./secret-file": {
      "types": "./dist/secret-file.d.ts",
      "import": "./dist/secret-file.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node ../../scripts/dev-prebuild.mjs && node ../../scripts/run-with-env.mjs --unset=PENGUIN_CLI_ENTRY PENGUIN_HOME=~/.penguin/dev-data PENGUIN_PROFILE=dev PORT=7368 -- node ../../scripts/dev-server.mjs src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "pnpm gen:ifaces && tsc --noEmit -p tsconfig.json",
    "gen:ifaces": "node ../../scripts/gen-ifaces.mjs --project tsconfig.json --out src/ifaces.json --project ../../plugins/company/tsconfig.json --project ../../plugins/terminal/tsconfig.json --project ../../plugins/browser/tsconfig.json --project ../../plugins/usage/tsconfig.json --project ../../plugins/schedules/tsconfig.json --project ../../plugins/machines/tsconfig.json --project ../../plugins/workbenches/tsconfig.json --project ../../plugins/projects/tsconfig.json --project ../../plugins/agents/tsconfig.json --project ../../plugins/settings/tsconfig.json --project ../../plugins/models/tsconfig.json --project ../../plugins/messaging/tsconfig.json --project ../../plugins/plugins/tsconfig.json",
    "test": "pnpm gen:ifaces && vitest run --passWithNoTests",
    "build": "pnpm gen:ifaces && node ../../scripts/run-with-env.mjs NODE_OPTIONS=--max-old-space-size=4096 -- tsup"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@larksuiteoapi/node-sdk": "^1.73.0",

    "@penguinharness/plugin-agents": "workspace:*",
    "@penguinharness/plugin-browser": "workspace:*",
    "@penguinharness/plugin-company": "workspace:*",
    "@penguinharness/plugin-machines": "workspace:*",
    "@penguinharness/plugin-messaging": "workspace:*",
    "@penguinharness/plugin-models": "workspace:*",
    "@penguinharness/plugin-plugins": "workspace:*",
    "@penguinharness/plugin-projects": "workspace:*",
    "@penguinharness/plugin-schedules": "workspace:*",
    "@penguinharness/plugin-settings": "workspace:*",
    "@penguinharness/plugin-terminal": "workspace:*",
    "@penguinharness/plugin-usage": "workspace:*",
    "@penguinharness/plugin-workbenches": "workspace:*",

    "@prismshadow/amsp": "workspace:*",
    "@prismshadow/mmsp": "^0.5.6",
    "@prismshadow/penguin-core": "workspace:*",
    "@xterm/headless": "^5.5.0",
    "commander": "^13.0.0",
    "dotenv": "^17.0.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.11",
    "isomorphic-git": "^1.44.0",
    "node-pty": "^1.1.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "smol-toml": "^1.9.1",
    "tar": "^7.5.21",
    "typescript": "^5.6.0",
    "undici": "^7.29.1",
    "unified": "^11.0.5",
    "ws": "^8.18.3",
    "yaml": "^2.5.0",
    "@penguinharness/plugin-agents": "workspace:*",
    "@penguinharness/plugin-browser": "workspace:*",
    "@penguinharness/plugin-company": "workspace:*",
    "@penguinharness/plugin-machines": "workspace:*",
    "@penguinharness/plugin-projects": "workspace:*",
    "@penguinharness/plugin-schedules": "workspace:*",
    "@penguinharness/plugin-settings": "workspace:*",
    "@penguinharness/plugin-terminal": "workspace:*",
    "@penguinharness/plugin-usage": "workspace:*",
    "@penguinharness/plugin-workbenches": "workspace:*"
  },
  "devDependencies": {
    "@prismshadow/penguin-hmr": "workspace:*",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "4.1.12",
    "tsup": "^8.3.0",
    "tsx": "^4.20.0",
    "vitest": "^4.1.12"
  },
  "files": [
    "dist",
    "web-dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
