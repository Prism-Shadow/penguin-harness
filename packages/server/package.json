    "@penguinharness/goal": "workspace:*",
    "@penguinharness/plan": "workspace:*",
    "@penguinharness/multimodal-tools": "workspace:*",
    "@penguinharness/model-development": "workspace:*",
    "@penguinharness/penguin-support": "workspace:*",
    "@penguinharness/software-development": "workspace:*",
    "@penguinharness/storage": "workspace:*",
    "@penguinharness/trace-lookup": "workspace:*",
    "@penguinharness/use-bento-slides": "workspace:*",
    "@prismshadow/a2ui": "workspace:*",
    "@prismshadow/amsp": "workspace:*",
    "@prismshadow/mmsp": "^0.5.12",
