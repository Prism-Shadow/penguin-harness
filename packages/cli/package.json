{
  "name": "@prismshadow/penguin-cli",
  "version": "0.2.20",
  "type": "module",
  "description": "PenguinHarness CLI: interactive REPL and single-task runner over @prismshadow/penguin-core.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "packages/cli"
  },
  "bin": {
    "penguin": "./dist/penguin.js",
    "penguin-hmr": "./dist/penguin-hmr.js"
  },
  "penguin": {
    "cliLoader": "./dist/penguin-hmr.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen:ifaces": "node ../../scripts/gen-cli-modules.mjs --package . --out src/cli-modules.gen.ts && node ../../scripts/gen-ifaces.mjs --project tsconfig.json --project ../server/tsconfig.json --sources src --sources test --sources ../server/src --sources ../server/test --sources ../../library --out src/ifaces.json --components-out src/cli-commands.gen.ts",
    "typecheck": "pnpm gen:ifaces && tsc --noEmit -p tsconfig.json",
    "test": "pnpm gen:ifaces && vitest run --passWithNoTests",
    "build": "pnpm gen:ifaces && tsup && node ../../scripts/stage-release-library.mjs",
    "penguin": "node ../../scripts/run-with-env.mjs --unset=PENGUIN_CLI_ENTRY PENGUIN_HOME=~/.penguin/dev-data-cli PENGUIN_PROFILE=dev PORT=7369 -- tsx src/penguin.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@penguinharness/agent-company": "workspace:*",
    "@penguinharness/agent-development": "workspace:*",
    "@penguinharness/agent-evaluation": "workspace:*",
    "@penguinharness/agent-state-git": "workspace:*",
    "@penguinharness/browser-automation": "workspace:*",
    "@penguinharness/computer-use": "workspace:*",
    "@penguinharness/data-analysis": "workspace:*",
    "@penguinharness/goal": "workspace:*",
    "@penguinharness/model-development": "workspace:*",
    "@penguinharness/multimodal-tools": "workspace:*",
    "@penguinharness/penguin-support": "workspace:*",
    "@penguinharness/plan": "workspace:*",
    "@penguinharness/software-development": "workspace:*",
    "@penguinharness/storage": "workspace:*",
    "@penguinharness/trace-lookup": "workspace:*",
    "@penguinharness/use-bento-slides": "workspace:*",
    "@prismshadow/a2ui": "workspace:*",
    "@prismshadow/mmsp": "^0.5.12",
    "@prismshadow/penguin-core": "workspace:*",
    "@prismshadow/penguin-library-machine": "workspace:*",
    "@prismshadow/penguin-server": "workspace:*",
    "commander": "^13.0.0",
    "dotenv": "^17.0.0",
    "fflate": "^0.8.3",
    "smol-toml": "^1.9.1",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@penguinharness/a2ui": "https://github.com/Prism-Shadow/penguin-harness-apps/releases/download/v2026.11.25/a2ui-0.2.19.tgz",
    "@penguinharness/continual-learning": "https://github.com/Prism-Shadow/penguin-harness-apps/releases/download/v2026.11.26/continual-learning-0.2.20.tgz",
    "@penguinharness/default-rsi-toolkit": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform/releases/download/v0.1.0/penguinharness-default-rsi-toolkit-0.2.19.tgz",
    "@penguinharness/skill-porting": "https://github.com/Prism-Shadow/penguin-harness-apps/releases/download/v2026.11.25/skill-porting-0.2.19.tgz",
    "@penguinharness/use-firecrawl": "https://github.com/Prism-Shadow/penguin-harness-apps/releases/download/v2026.11.25/use-firecrawl-0.2.19.tgz",
    "@types/node": "^24.0.0",
    "electron": "^43.7.6",
    "node-pty": "^1.1.0",
    "tsup": "^8.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
