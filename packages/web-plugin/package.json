    "directory": "packages/web-plugin"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./host": "./src/host.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@prismshadow/penguin-ui": "workspace:*",
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@prismshadow/penguin-ui": "workspace:*",
    "@types/react": "^19.1.0",
