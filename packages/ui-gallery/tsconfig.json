{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "paths": {
      "@prismshadow/penguin-server/api": [
        "../server/src/api/types.ts"
      ],
      "@penguinharness/plugin-plugins/server": [
        "../../plugins/plugins/src/server/index.ts"
      ],
      "@penguinharness/plugin-sandbox/server": [
        "../../plugins/sandbox/src/server/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
