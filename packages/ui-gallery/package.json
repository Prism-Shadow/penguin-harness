{
  "name": "@prismshadow/penguin-ui-gallery",
  "version": "0.2.17",
  "private": true,
  "type": "module",
  "description": "PenguinHarness UI gallery (dev tool, Vite + React; also published on the public site under /gallery/): the real Web App framed against an in-browser demo API, one page per surface in every theme, mode, text size, font pairing and language, plus the Foundations boards and the bundled fonts.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test -c e2e/playwright.config.mjs",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@prismshadow/penguin-ui": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@prismshadow/amsp": "workspace:*",
    "@prismshadow/penguin-core": "workspace:*",
    "@prismshadow/penguin-web": "workspace:*",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
