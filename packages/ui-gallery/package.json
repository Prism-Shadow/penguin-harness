    "@penguinharness/storage": "workspace:*",
    "@penguinharness/trace-rsi-toolkit": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform/releases/download/v0.1.0-rc.2/penguinharness-trace-rsi-toolkit-0.2.19-rc.1.tgz",
    "@prismshadow/a2ui": "workspace:*",
    "@prismshadow/amsp": "workspace:*",
    "@prismshadow/penguin-core": "workspace:*",
    "@prismshadow/penguin-library-observability": "workspace:*",
    "@prismshadow/penguin-web": "workspace:*",
    "@prismshadow/penguin-web-plugin": "workspace:*",
    "@prismshadow/skills": "workspace:*",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
