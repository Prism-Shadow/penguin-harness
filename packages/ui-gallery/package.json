{
  "name": "@prismshadow/penguin-ui-gallery",
  "version": "0.2.20",
  "private": true,
  "type": "module",
  "description": "PenguinHarness UI gallery (dev tool, Vite + React; also published on the public site under /gallery/): the real Web App framed against an in-browser demo API, one page per surface in every theme, mode, text size, font pairing and language, plus the Foundations boards and the bundled fonts.",
  "scripts": {
    "dev": "pnpm --filter @prismshadow/penguin-web gen:ifaces && vite",
    "build": "pnpm --filter @prismshadow/penguin-web gen:ifaces && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm --filter @prismshadow/penguin-web gen:ifaces && tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @prismshadow/penguin-web gen:ifaces && vitest run --passWithNoTests",
    "test:e2e": "playwright test -c e2e/playwright.config.mjs",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@prismshadow/penguin-ui": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@penguinharness/a2ui": "https://github.com/Prism-Shadow/penguin-harness-apps/releases/download/v2026.11.25/a2ui-0.2.19.tgz",
    "@penguinharness/humanizer": "https://github.com/Prism-Shadow/penguin-harness-apps/releases/download/v2026.11.23-rc.6/humanizer-0.2.19-rc.1.tgz",
    "@penguinharness/use-claude-code": "https://github.com/Prism-Shadow/penguin-harness-apps/releases/download/v2026.11.23-rc.6/use-claude-code-0.2.19-rc.1.tgz",
    "@penguinharness/use-firecrawl": "https://github.com/Prism-Shadow/penguin-harness-apps/releases/download/v2026.11.25/use-firecrawl-0.2.19.tgz",
    "@playwright/test": "^1.61.1",
    "@penguinharness/ace-rsi-toolkit": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform/releases/download/v0.1.0-rc.2/penguinharness-ace-rsi-toolkit-0.2.19-rc.1.tgz",
    "@penguinharness/ape-rsi-toolkit": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform/releases/download/v0.1.0-rc.2/penguinharness-ape-rsi-toolkit-0.2.19-rc.1.tgz",
    "@penguinharness/awm-rsi-toolkit": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform/releases/download/v0.1.0-rc.2/penguinharness-awm-rsi-toolkit-0.2.19-rc.1.tgz",
    "@penguinharness/default-rsi-toolkit": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform/releases/download/v0.1.0/penguinharness-default-rsi-toolkit-0.2.19.tgz",
    "@penguinharness/openskill-rsi-toolkit": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform/releases/download/v0.1.0-rc.2/penguinharness-openskill-rsi-toolkit-0.2.22-rc.1.tgz",
    "@penguinharness/opro-rsi-toolkit": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform/releases/download/v0.1.0-rc.2/penguinharness-opro-rsi-toolkit-0.2.19-rc.1.tgz",
    "@penguinharness/rrsi-rsi-toolkit": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform/releases/download/v0.1.0-rc.2/penguinharness-rrsi-rsi-toolkit-0.2.19-rc.1.tgz",
    "@penguinharness/skilladam-rsi-toolkit": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform/releases/download/v0.1.0-rc.2/penguinharness-skilladam-rsi-toolkit-0.2.19-rc.1.tgz",
