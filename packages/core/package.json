{
  "name": "@prismshadow/penguin-core",
  "version": "0.2.18",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "PenguinHarness core SDK: context_engine, the AMSP records it speaks, LLM/Environment interfaces.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    },
    "./context-limits": {
      "types": "./dist/llm/context-limits.d.ts",
      "import": "./dist/llm/context-limits.js"
    },
    "./model-connection": {
      "types": "./dist/state/model-connection.d.ts",
      "import": "./dist/state/model-connection.js"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "import": "./dist/kernel/index.js",
      "default": "./dist/kernel/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "penguin-gen-ifaces": "./bin/gen-ifaces.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/build-benchmarks.mjs && vitest run --passWithNoTests",
    "test:e2e": "node ../../scripts/run-with-env.mjs PENGUIN_E2E=1 -- vitest run test/llm.e2e.test.ts",
    "build": "tsup"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@prismshadow/amsp": "workspace:*",
    "@prismshadow/mmsp": "^0.5.6",
    "arktype": "^2.2.3",
    "smol-toml": "^1.9.1",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@prismshadow/skills": "workspace:*",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "dotenv": "^17.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12",
    "zod": "^4.2.0"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
