{
  "name": "@prismshadow/penguin-desktop",
  "version": "0.2.18",
  "private": true,
  "type": "module",
  "description": "PenguinHarness desktop app: Electron shell running @prismshadow/penguin-server as a utilityProcess, window on http://localhost (same-origin HTTP/SSE; the only IPC is the window-controls bridge).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup && node scripts/build-assets.mjs && node ../../scripts/stage-release-library.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "start": "node scripts/preflight.mjs && electron .",
    "image": "node ../../scripts/deploy.mjs --out dist/install-image.gz --skip-web-build",
    "pack": "node scripts/preflight.mjs && pnpm run image && electron-builder",
    "pack:linux": "node scripts/preflight.mjs && pnpm run image && electron-builder --linux",
    "pack:mac": "node scripts/preflight.mjs && pnpm run image && electron-builder --mac",
    "pack:win": "node scripts/preflight.mjs && pnpm run image && electron-builder --win"
  },
  "dependencies": {
    "@penguinharness/agent-company": "workspace:*",
    "@penguinharness/agent-development": "workspace:*",
    "@penguinharness/agent-evaluation": "workspace:*",
    "@penguinharness/agent-state-git": "workspace:*",
    "@penguinharness/browser-automation": "workspace:*",
    "@penguinharness/computer-use": "workspace:*",
    "@penguinharness/data-analysis": "workspace:*",
    "@penguinharness/first-workbench-guide": "workspace:*",
    "@penguinharness/goal": "workspace:*",
    "@penguinharness/plan": "workspace:*",
    "@penguinharness/multimodal-tools": "workspace:*",
    "@penguinharness/model-development": "workspace:*",
    "@penguinharness/penguin-support": "workspace:*",
    "@penguinharness/software-development": "workspace:*",
    "@penguinharness/storage": "workspace:*",
    "@penguinharness/trace-lookup": "workspace:*",
    "@penguinharness/use-bento-slides": "workspace:*"
  },
  "devDependencies": {
    "@penguinharness/a2ui": "https://github.com/Prism-Shadow/penguin-harness-apps/releases/download/v2026.11.23-rc.6/a2ui-0.2.19-rc.1.tgz",
    "@penguinharness/ace-rsi-toolkit": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform/releases/download/v0.1.0-rc.2/penguinharness-ace-rsi-toolkit-0.2.19-rc.1.tgz",
    "@penguinharness/ape-rsi-toolkit": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform/releases/download/v0.1.0-rc.2/penguinharness-ape-rsi-toolkit-0.2.19-rc.1.tgz",
    "@penguinharness/awm-rsi-toolkit": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform/releases/download/v0.1.0-rc.2/penguinharness-awm-rsi-toolkit-0.2.19-rc.1.tgz",
    "@penguinharness/continual-learning": "https://github.com/Prism-Shadow/penguin-harness-apps/releases/download/v2026.11.23-rc.9/continual-learning-0.2.19-rc.2.tgz",
    "@penguinharness/default-rsi-toolkit": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform/releases/download/v0.1.0-rc.2/penguinharness-default-rsi-toolkit-0.2.19-rc.1.tgz",
    "@penguinharness/openskill-rsi-toolkit": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform/releases/download/v0.1.0-rc.2/penguinharness-openskill-rsi-toolkit-0.2.22-rc.1.tgz",
    "@penguinharness/opro-rsi-toolkit": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform/releases/download/v0.1.0-rc.2/penguinharness-opro-rsi-toolkit-0.2.19-rc.1.tgz",
    "@penguinharness/rrsi-rsi-toolkit": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform/releases/download/v0.1.0-rc.2/penguinharness-rrsi-rsi-toolkit-0.2.19-rc.1.tgz",
    "@penguinharness/skill-porting": "https://github.com/Prism-Shadow/penguin-harness-apps/releases/download/v2026.11.23-rc.6/skill-porting-0.2.19-rc.1.tgz",
    "@penguinharness/skilladam-rsi-toolkit": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform/releases/download/v0.1.0-rc.2/penguinharness-skilladam-rsi-toolkit-0.2.19-rc.1.tgz",
    "@penguinharness/skillopt-rsi-toolkit": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform/releases/download/v0.1.0-rc.2/penguinharness-skillopt-rsi-toolkit-0.2.19-rc.1.tgz",
    "@penguinharness/trace-rsi-toolkit": "https://github.com/Prism-Shadow/penguin-harness-rsi-platform/releases/download/v0.1.0-rc.2/penguinharness-trace-rsi-toolkit-0.2.19-rc.1.tgz",
    "@penguinharness/use-firecrawl": "https://github.com/Prism-Shadow/penguin-harness-apps/releases/download/v2026.11.23-rc.6/use-firecrawl-0.2.19-rc.1.tgz",
    "@prismshadow/penguin-cli": "workspace:*",
    "@prismshadow/penguin-core": "workspace:*",
    "@prismshadow/penguin-server": "workspace:*",
    "@types/node": "^24.0.0",
    "electron": "^43.7.6",
    "electron-builder": "^26.16.1",
    "electron-updater": "^6.8.9",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12",
    "yaml": "^2.5.0"
  }
}
