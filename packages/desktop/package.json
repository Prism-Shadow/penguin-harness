{
  "name": "@prismshadow/penguin-desktop",
  "version": "0.2.18",
  "private": true,
  "type": "module",
  "description": "PenguinHarness desktop app: Electron shell running @prismshadow/penguin-server as a utilityProcess, window on http://localhost (same-origin HTTP/SSE, no private IPC).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup && node scripts/build-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "start": "node scripts/preflight.mjs && electron .",
    "image": "node ../../scripts/deploy.mjs --out dist/install-image.gz --skip-web-build",
    "pack": "node scripts/preflight.mjs && pnpm run image && electron-builder",
    "pack:linux": "node scripts/preflight.mjs && pnpm run image && electron-builder --linux",
    "pack:mac": "node scripts/preflight.mjs && pnpm run image && electron-builder --mac",
    "pack:win": "node scripts/preflight.mjs && pnpm run image && electron-builder --win"
  },
  "dependencies": {
    "@penguinharness/a2ui": "workspace:*",
    "@penguinharness/ace-rsi-toolkit": "workspace:*",
    "@penguinharness/agent-company": "workspace:*",
    "@penguinharness/agent-development": "workspace:*",
    "@penguinharness/agent-evaluation": "workspace:*",
    "@penguinharness/ape-rsi-toolkit": "workspace:*",
    "@penguinharness/awm-rsi-toolkit": "workspace:*",
    "@penguinharness/browser-automation": "workspace:*",
    "@penguinharness/continual-learning": "workspace:*",
    "@penguinharness/data-analysis": "workspace:*",
    "@penguinharness/default-rsi-toolkit": "workspace:*",
    "@penguinharness/goal": "workspace:*",
    "@penguinharness/humanizer": "workspace:*",
    "@penguinharness/model-development": "workspace:*",
    "@penguinharness/opro-rsi-toolkit": "workspace:*",
    "@penguinharness/penguin-support": "workspace:*",
    "@penguinharness/skill-porting": "workspace:*",
    "@penguinharness/software-development": "workspace:*",
    "@penguinharness/use-bento-slides": "workspace:*",
    "@penguinharness/use-firecrawl": "workspace:*",
    "@penguinharness/use-claude-code": "workspace:*"
  },
  "devDependencies": {
    "@prismshadow/penguin-cli": "workspace:*",
    "@prismshadow/penguin-core": "workspace:*",
    "@prismshadow/penguin-server": "workspace:*",
    "@types/node": "^24.0.0",
    "electron": "^43.7.6",
    "electron-builder": "^26.16.1",
    "electron-updater": "^6.8.9",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12",
    "yaml": "^2.5.0"
  }
}
