{
  "name": "@prismshadow/amsp",
  "version": "0.2.17",
  "type": "module",
  "description": "AMSP (Agent Message Stream Protocol): the records a PenguinHarness Session streams, their builders and markers, the wire types of an Agent's API and a zero-dependency client for Node 24 and browsers.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "packages/amsp"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./records": {
      "types": "./dist/records.d.ts",
      "import": "./dist/records.js"
    },
    "./markers": {
      "types": "./dist/markers.d.ts",
      "import": "./dist/markers.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/browser/amsp.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsup"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
