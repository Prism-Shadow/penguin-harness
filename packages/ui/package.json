{
  "name": "@prismshadow/penguin-ui",
  "version": "0.2.18",
  "type": "module",
  "description": "PenguinHarness UI: the React components, design tokens and four themes of the PenguinHarness Web App, with a precompiled stylesheet and optional fonts.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prism-Shadow/penguin-harness.git",
    "directory": "packages/ui"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": {
      "style": "./src/theme.css",
      "default": "./src/theme.css"
    },
    "./themes/*": "./src/themes/*",
    "./fonts.css": {
      "style": "./src/fonts/index.css",
      "default": "./src/fonts/index.css"
    },
    "./boot": "./src/boot.ts",
    "./highlighter": "./src/components/content/code-block/highlighter-core.ts",
    "./fonts-credits": "./src/fonts/credits.ts",
    "./testing": "./src/testing/index.ts",
    "./pack-rules": "./src/testing/pack-rules.ts",
    "./site": "./src/site.ts",
    "./site.css": {
      "style": "./src/site.css",
      "default": "./src/site.css"
    },
    "./site-page.css": {
      "style": "./src/site-page.css",
      "default": "./src/site-page.css"
    },
    "./cursors.css": {
      "style": "./src/cursors.css",
      "default": "./src/cursors.css"
    }
  },
  "scripts": {
    "build": "node scripts/build-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "sync:font-licenses": "node scripts/sync-font-licenses.mjs",
    "fonts:misans": "uv run scripts/build-misans.py",
    "fonts:wenkai": "node scripts/vendor-wenkai.mjs",
    "draw:doodle": "node scripts/draw-doodle-edges.mjs"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "dependencies": {
    "@shikijs/langs": "^4.3.1",
    "@shikijs/themes": "^4.3.1",
    "katex": "^0.16.47",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-gfm-strikethrough": "^2.0.0",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-gfm-task-list-item": "^2.0.0",
    "mermaid": "^11.17.2",
    "micromark-extension-cjk-friendly": "^2.0.2",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "shiki": "^4.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/shantell-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@prismshadow/a2ui": "workspace:*",
    "@prismshadow/chat-markdown": "workspace:*",
    "@prismshadow/penguin-theme-pack": "workspace:*",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.28.1",
    "jsdom": "^30.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rollup": "^4.40.0",
    "rollup-plugin-dts": "^6.2.1",
    "supports-color": "^10.2.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/*.css",
    "dist/chunks",
    "dist/assets",
    "dist/fonts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./highlighter": {
        "types": "./dist/highlighter.d.ts",
        "import": "./dist/highlighter.js"
      },
      "./styles.css": "./dist/styles.css",
      "./fonts.css": "./dist/fonts.css"
    }
  }
}
