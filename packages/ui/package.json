{
  "name": "@prismshadow/penguin-ui",
  "version": "0.2.13",
  "private": true,
  "type": "module",
  "description": "PenguinHarness shared UI: design tokens, the three themes, bundled fonts and the component set the Web App and the gallery render.",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": {
      "style": "./src/theme.css",
      "default": "./src/theme.css"
    },
    "./themes/*": "./src/themes/*",
    "./fonts.css": {
      "style": "./src/fonts/index.css",
      "default": "./src/fonts/index.css"
    },
    "./boot": "./src/boot.ts",
    "./highlighter": "./src/components/content/code-block/highlighter-core.ts",
    "./fonts-credits": "./src/fonts/credits.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "sync:font-licenses": "node scripts/sync-font-licenses.mjs",
    "fonts:misans": "uv run scripts/build-misans.py"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource/commit-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@shikijs/langs": "^4.3.1",
    "@shikijs/themes": "^4.3.1",
    "katex": "^0.16.47",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "shiki": "^4.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}
