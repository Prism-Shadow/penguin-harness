{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "paths": {
      "@prismshadow/penguin-server/api": ["../server/src/api/types.ts"],
      "@prismshadow/penguin-library-machine/web": ["../../library/machine/src/web/index.ts"],
      "@prismshadow/penguin-library-machine/web/*": ["../../library/machine/src/web/*"],
      "@prismshadow/penguin-library-sandbox/web": ["../../library/sandbox/src/web/index.ts"],
      "@prismshadow/penguin-library-sandbox/web/*": ["../../library/sandbox/src/web/*"],
      "@prismshadow/penguin-library-terminal/web": ["../../library/terminal/src/web/index.ts"],
      "@prismshadow/penguin-library-terminal/web/*": ["../../library/terminal/src/web/*"],
      "@prismshadow/penguin-library-workspace/web": ["../../library/workspace/src/web/index.ts"],
      "@prismshadow/penguin-library-workspace/web/*": ["../../library/workspace/src/web/*"],
      "@prismshadow/penguin-web/internal": ["./src/internal.ts"]
    }
  },
  "include": ["src", "test", "scripts", "vite.config.ts", "vitest.config.ts"]
}
