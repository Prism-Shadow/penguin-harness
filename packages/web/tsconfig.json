{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "paths": {
      "@prismshadow/penguin-server/api": ["../server/src/api/types.ts"],
      "@prismshadow/penguin-server/model-catalog": ["../server/src/model-catalog/index.ts"],
      "@prismshadow/penguin-web/internal": ["./src/internal.ts"],
      "@prismshadow/penguin-web/internal-hub": ["./src/internal-hub.ts"],
      "@prismshadow/penguin-library-session/web": ["../../library/session/src/web/index.ts"],
      "@prismshadow/penguin-library-session/web/*": ["../../library/session/src/web/*"]
    }
  },
  "include": ["src", "test", "scripts", "vite.config.ts", "vitest.config.ts"]
}
