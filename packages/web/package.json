{
  "name": "@prismshadow/penguin-web",
  "version": "0.2.20",
  "private": true,
  "type": "module",
  "exports": {
    "./internal": "./src/internal.ts"
  },
  "description": "PenguinHarness web frontend SPA: React + Vite + Tailwind CSS, rendering conversations streamed as AMSP records, plus Agent configuration, model configuration, usage stats, and Traces.",
  "scripts": {
    "dev": "pnpm gen:ifaces && vite",
    "build": "pnpm gen:ifaces && vite build",
    "preview": "vite preview",
    "typecheck": "node scripts/gen-web-table.mjs --tests && tsc --noEmit -p tsconfig.json",
    "gen:ifaces": "node scripts/gen-web-table.mjs",
    "test": "node scripts/gen-web-table.mjs --tests && vitest run --passWithNoTests",
    "test:e2e": "bash e2e/run.sh"
  },
  "dependencies": {
    "@penguinharness/browser-automation": "workspace:*",
    "@penguinharness/storage": "workspace:*",
    "@prismshadow/amsp": "workspace:*",
    "@prismshadow/penguin-core": "workspace:*",
    "@prismshadow/penguin-library-messaging": "workspace:*",
    "@prismshadow/penguin-library-observability": "workspace:*",
    "@prismshadow/penguin-library-plugin": "workspace:*",
    "@prismshadow/penguin-library-setting": "workspace:*",
    "@prismshadow/penguin-ui": "workspace:*",
    "@prismshadow/penguin-web-plugin": "workspace:*",
    "@xterm/addon-clipboard": "^0.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "copy-to-clipboard": "^4.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "uqr": "^0.1.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@penguinharness/reading-desk": "https://github.com/Prism-Shadow/penguin-harness-apps/releases/download/v2026.11.23-rc.6/reading-desk-0.2.20-rc.1.tgz",
    "@playwright/test": "^1.61.1",
    "@prismshadow/penguin-server": "workspace:*",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
